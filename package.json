{
  "name": "@red-cup-engineering/github-reconciliation-service",
  "version": "0.2.0-dev.0",
  "type": "module",
  "description": "Typed source admission and read-only observation of GitHub branches, archive-tagged code, PRs and original issues, with no parallel debt register or effect authority.",
  "bin": {
    "github-reconcile": "./bin/github-reconcile.mjs"
  },
  "exports": {
    ".": "./src/reconcile.mjs",
    "./classify": "./src/classify.mjs",
    "./client": "./src/github-client.mjs",
    "./equivalent-branch": "./src/equivalent-branch.mjs",
    "./receive-equivalent": "./src/receive-equivalent.mjs",
    "./archive-ref-observation": "./src/archive-ref-observation.mjs",
    "./source-report": "./src/source-report.mjs",
    "./source-brief": "./src/source-brief.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/github-reconciliation-service.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
