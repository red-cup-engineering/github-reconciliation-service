[Unit]
Description=Reconcile open pull requests, branches and issues of the 561 Group organizations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=github-reconcile
LoadCredentialEncrypted=github-token:/etc/credstore.encrypted/github-reconcile-token
ExecStart=/opt/github-reconcile/current/bin/github-reconcile.mjs --apply \
  --org red-cup-engineering --org 561-group --org causeway-services --org lenticule-science --org coesite-operations \
  --register %S/github-reconcile/system-debt-records
